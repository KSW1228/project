//
// named.conf  (SLAVE)  -- Ansible 관리 파일, 직접 수정 금지
//   슬레이브는 존 파일을 직접 만들지 않고 마스터(185)에서 받아옴.
//
options {
    listen-on port 53 { 127.0.0.1; {{ dns_slave_ip }}; };
    listen-on-v6 port 53 { ::1; };
    directory       "/var/named";
    allow-query     { localhost; {{ net_prefix }}.0/24; };
    allow-transfer  { none; };
    recursion yes;
    // ── 외부 도메인 포워딩 (마스터와 동일) ──
    forwarders { {% for fwd in dns_forwarders %}{{ fwd }}; {% endfor %}};
    forward only;
    dnssec-validation no;
    pid-file "/run/named/named.pid";
    session-keyfile "/run/named/session.key";
};

logging {
    channel default_debug {
        file "data/named.run";
        severity dynamic;
    };
};

zone "." IN {
    type hint;
    file "named.ca";
};

// ===========================================================
//  정방향 존 (마스터에서 받아옴) — managed_domains 에서 자동 생성
// ===========================================================
{% for d in managed_domains %}
zone "{{ d.name }}" IN {
    type slave;
    masters { {{ dns_master_ip }}; };
    file "slaves/{{ d.name }}.zone";
};
{% endfor %}

// ── 역방향 존 (마스터에서 받아옴) ──
zone "{{ reverse_zone }}" IN {
    type slave;
    masters { {{ dns_master_ip }}; };
    file "slaves/{{ reverse_zone }}.zone";
};

include "/etc/named.rfc1912.zones";
include "/etc/named.root.key";
