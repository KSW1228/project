#[mail_servers:children]
#mail1
#mail2

# ── IPA 클라이언트로 가입할 서버들 ──
[ipa_clients:children]
web
db
dns
file_servers
ftp
#mail1
#mail2

# ===========================================================
#  DNS 역할 그룹 (마스터/슬레이브 분리)
#  - dns_master: 존 파일을 직접 소유하는 주인 (25)
#  - dns_slave : 마스터에서 존을 받아오는 보조본 (web=24 에 고정)
# ===========================================================
[dns_master]
10.0.2.25

[dns_slave]
10.0.2.24

# ── dns_master + dns_slave 를 묶는 상위 그룹 ──
#   공통 DNS 변수(domain, master_ip 등)를 group_vars/dns_servers.yml
#   한 곳에만 적기 위한 부모 그룹. 중복 제거용.
[dns_servers:children]
dns_master
dns_slave
